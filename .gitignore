# ==========================================
# Git Ignore Rules (.gitignore)
# Files & directories matching these patterns will NOT be tracked by Git.
# ==========================================

# 1. Environment variables & secrets (CRITICAL: Never track actual secret keys!)
.env
.env.local
.env.production
*.env

# 2. Dependency directories (heavy files managed by package managers)
node_modules/
/bower_components

# 3. Build & Output directories
dist/
build/
out/
*.apk
*.exe

# 4. Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. OS Generated Files
.DS_Store
Thumbs.db
ehthumbs.db

# 6. IDE / Code Editor files
.vscode/
.idea/
*.swp
*.swo
